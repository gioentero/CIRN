plot_model_posteriors_if_available <- function(model) {
coef_names <- rownames(brms::fixef(model))
coef_names <- coef_names[coef_names != "Intercept"]
if (length(coef_names) == 0) {
return(invisible(NULL))
}
suppressWarnings(
plot_all_posterior_effects(
model = model,
terms = coef_names
)
)
}
