output_suffix <- gsub("[^A-Za-z0-9]+", "_", representation_name)
}
output_file <- file.path(
output_dir,
paste0(
"Target_",
gsub("[^A-Za-z0-9]+", "_", this_target),
"_Posterior_Effects_",
output_suffix,
".png"
)
)
